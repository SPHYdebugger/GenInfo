<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D77AA">

    <ImageView
        android:id="@+id/headerImage"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:scaleType="centerCrop"
        android:src="@drawable/horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/botoneraSettings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerImage">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/settings_title"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAjustarCorreo"
            android:layout_width="275dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:backgroundTint="#015987"
            android:text="@string/settings_adjust_email"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btnVerLogs"
            android:layout_width="275dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:backgroundTint="#015987"
            android:text="@string/settings_view_logs"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btnCambiarIdioma"
            android:layout_width="275dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:backgroundTint="#015987"
            android:text="@string/settings_change_language"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btnBorrarDatos"
            android:layout_width="275dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:backgroundTint="#8B1A1A"
            android:text="@string/settings_delete_all_data"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btnBackSettings"
            android:layout_width="275dp"
            android:layout_height="wrap_content"
            android:backgroundTint="#015987"
            android:text="@string/common_back"
            android:textColor="@android:color/white" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
