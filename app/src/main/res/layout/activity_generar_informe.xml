<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- Encabezado con imagen -->
        <ImageView
            android:id="@+id/headerImage"
            android:layout_width="match_parent"
            android:layout_height="153dp"
            android:scaleType="fitStart"
            android:src="@drawable/horizontal" />


        <!-- Referencia -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/field_reference_intervention"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputReferencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/edit_text"
            android:inputType="textCapSentences"
            android:padding="8dp" />

        <!-- SINIESTRO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/field_incident"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputSiniestro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/edit_text"
            android:inputType="textCapSentences"
            android:padding="8dp" />

        <!-- REQUIRENTE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/field_requester"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputRequirente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/edit_text"
            android:inputType="textCapSentences"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/field_place"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputLugar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/edit_text"
            android:inputType="textCapSentences"
            android:padding="8dp" />

        <!-- TÉCNICO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/field_people_present"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputTecnico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/edit_text"
            android:inputType="textCapSentences"
            android:padding="8dp" />

        <!-- BARCO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/field_boat_name"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputNombreBarco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/edit_text"
            android:inputType="textCapSentences"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/field_registration"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputMatricula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/edit_text"
            android:inputType="textCapSentences"
            android:padding="8dp" />


        <!-- Trabajo realizado -->

        <!-- DAÑOS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/field_damage"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputDaños"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/edit_text"
            android:gravity="top"
            android:inputType="textMultiLine|textCapSentences"
            android:minHeight="100dp"
            android:padding="8dp" />

        <!-- CAUSAS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/field_causes"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputCausas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/edit_text"
            android:gravity="top"
            android:inputType="textMultiLine|textCapSentences"
            android:minHeight="100dp"
            android:padding="8dp" />

        <!-- RESERVA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/field_reserve"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputReserva"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/edit_text"
            android:gravity="top"
            android:inputType="textMultiLine|textCapSentences"
            android:minHeight="100dp"
            android:padding="8dp" />

        <!-- OBSERVACIONES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/field_observations"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputObservaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/edit_text"
            android:gravity="top"
            android:inputType="textMultiLine|textCapSentences"
            android:minHeight="100dp"
            android:padding="8dp" />

        <!-- DOCUMENTACIÓN PENDIENTE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/field_pending_docs"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputDocP"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/edit_text"
            android:gravity="top"
            android:inputType="textMultiLine|textCapSentences"
            android:minHeight="100dp"
            android:padding="8dp" />

        <!-- Lista de imágenes adjuntadas -->
        <TextView
            android:id="@+id/textAdjuntos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/attached_images"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutImagenesAdjuntas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />


        <!-- Botón Adjuntar Fotos -->
        <Button
            android:id="@+id/btnAdjuntarFotos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#007bbb"
            android:text="@string/attach_photos"
            android:textColor="@android:color/white" />

        <!-- Línea horizontal de separación -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="@android:color/darker_gray" />

        <!-- Botón Generar Informe (Ahora grande) -->
        <Button
            android:id="@+id/btnGenerarInforme"
            android:layout_width="match_parent"
            android:layout_height="63dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/boton_redondeado"
            android:text="@string/generate_report"
            android:textColor="@android:color/white" />

        <!-- Botón Volver al inicio (Ahora pequeño y rojo) -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#8B1A1A"
            android:background="@drawable/boton_redondeado_rojo"
            android:text="@string/back_to_menu"
            android:textColor="@android:color/white" />


        </LinearLayout>
    </ScrollView>

    <View
        android:id="@+id/overlayBloqueo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />
</FrameLayout>
