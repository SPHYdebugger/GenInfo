<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.comismar.informes">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".view.activity.MainActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.activity.LoginActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.activity.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".view.activity.GenerarInformeActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <activity
            android:name=".view.activity.ListaInformesActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.activity.PdfPreviewActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.activity.EditarInformeActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.activity.SettingsActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.activity.LogsActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.activity.PoliticaPrivacidadActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".view.activity.DatosContactoActivity"
            android:screenOrientation="portrait" />
    </application>

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />

</manifest>
